[Unit]
Description=peperspray credential access guard daemon
Documentation=https://github.com/eresende/peperspray
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/pepersprayd --config /etc/peperspray/config.toml --log-file /var/log/peperspray/events.jsonl

# Restart the guard whenever it exits. on-failure would leave the host
# unprotected after a clean stop/kill, so prefer always with a short backoff.
Restart=always
RestartSec=2s

# --- Sandboxing ---------------------------------------------------------
# The daemon must run as root: fanotify permission marks require
# CAP_SYS_ADMIN, and it reads credential files under user homes (often
# mode 0700) to canonicalize protected paths, which needs
# CAP_DAC_READ_SEARCH. Process identity collection reads /proc/<pid>/exe for
# user processes, which can require CAP_SYS_PTRACE on hardened hosts.
# Everything else is stripped.
#
# IMPORTANT: enforcement depends on CAP_SYS_ADMIN. If you tighten the
# capability set or syscall filter further, re-verify that
# fanotify_init()/fanotify_mark() still succeed on the target kernel.
#
# The CAP_SETUID/CAP_SETGID/CAP_SETPCAP/CAP_DAC_OVERRIDE/CAP_AUDIT_WRITE
# capabilities are required by the `runuser` call that delivers denied-read
# desktop notifications into the target user's session bus. See the
# "Desktop notifications" section below for how to drop them again if you
# prefer the stricter no-notification profile.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_AUDIT_WRITE
AmbientCapabilities=
UMask=0027

# Filesystem protection: read-only system, read-only homes (the daemon only
# reads credential paths), writable audit log only.
ProtectSystem=strict
ReadWritePaths=/var/log/peperspray
ProtectHome=read-only
PrivateTmp=yes

# Kernel, process, and control-group protection.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Desktop notifications spawn `runuser`, which loads PAM modules that may map
# writable+executable memory, so MemoryDenyWriteExecute must stay off. Set it
# back to yes if you disable notifications (see the section below).
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
# Baseline allow-list for system services, plus the fanotify syscalls the
# guard depends on. fanotify_init/fanotify_mark are classified under
# @privileged and are NOT part of @system-service, so they must be allowed
# explicitly or the daemon is killed with SIGSYS on startup.
#
# @setuid covers the setuid/setgid/setgroups syscalls that `runuser` invokes
# to drop into the target user's session for desktop notifications. Remove
# this line if you disable notifications (see the section below).
SystemCallFilter=@system-service
SystemCallFilter=@setuid
SystemCallFilter=fanotify_init fanotify_mark

# --- Desktop notifications ----------------------------------------------
# Denied-read desktop notifications are enabled by default. They are
# implemented by spawning `runuser` to enter the target user's session bus,
# which requires the privilege-changing capabilities, the @setuid syscall
# group, and writable+executable memory for PAM that the directives above
# grant. The daemon treats notification failures as non-fatal: denies are
# still enforced and logged even if the popup cannot be delivered.
#
# Enabling notifications widens the attack surface of a root daemon. To run
# the stricter no-notification profile instead, revert these directives:
#
#   CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
#   MemoryDenyWriteExecute=yes
#   # and remove the `SystemCallFilter=@setuid` line above
#
# With those reverted, denies are still enforced and logged; only the
# desktop popups are disabled.

[Install]
WantedBy=multi-user.target
