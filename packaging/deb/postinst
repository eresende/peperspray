#!/bin/sh
set -eu

if [ "$1" = "configure" ]; then
    install -d -o root -g root -m 0755 /etc/peperspray
    install -d -o root -g adm -m 0750 /var/log/peperspray

    if [ ! -e /var/log/peperspray/events.jsonl ]; then
        install -o root -g adm -m 0640 /dev/null /var/log/peperspray/events.jsonl
    fi
    chown root:adm /var/log/peperspray/events.jsonl
    chmod 0640 /var/log/peperspray/events.jsonl

    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi
fi

exit 0
